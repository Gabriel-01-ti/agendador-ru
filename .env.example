# Configure no painel de segredos da hospedagem ou em .env local (nunca no Git).
AUTOMATION_ENABLED=false
RU_USER=
RU_PASSWORD=
ADMIN_PASSWORD=
APP_SECRET=
PUBLIC_URL=https://seu-dominio.example
DATA_DIR=/data
REMINDER_ENABLED=false
REMINDER_TIME=08:00
# As reservas ocorrem domingo às 09:00 de Brasília (horário fixo no código).
CUTOFF_TIME=15:55
HEADLESS=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+NUMERO_REMETENTE
WHATSAPP_TO=whatsapp:+55SEUNUMERO
TWILIO_CONTENT_SID=

# Plano gratuito: use GitHub Actions; mantenha AUTOMATION_ENABLED=false no Render.
STATE_BACKEND=github
STATE_REPOSITORY=Gabriel-01-ti/agendador-ru
STATE_TOKEN=
WHATSAPP_PROVIDER=callmebot
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
SCHEDULE_ENABLED=false
